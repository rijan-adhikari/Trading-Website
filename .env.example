# --- Database ---
# Leave unset for local SQLite development, or use PostgreSQL for Docker/production.
# DATABASE_URL=postgresql+psycopg2://nepse:nepse_dev_password@localhost:5432/nepse_paper_trader

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Trading / Paper Money ---
INITIAL_VIRTUAL_BALANCE=1000000
BASE_CURRENCY=NPR

# --- Trading Fees (demo values, NOT real NEPSE/broker fees) ---
FEE_COMMISSION_PCT=0.36
FEE_REGULATORY_PCT=0.015
FEE_SEBON_PCT=0.015
FEE_SETTLEMENT_PCT=0.01

# --- Market Data ---
MARKET_MODE=demo
MARKET_API_BASE_URL=
MARKET_API_KEY=
MARKET_DATA_DELAY_SECONDS=0
MARKET_TIMEZONE=Asia/Kathmandu
MARKET_OPEN=11:00
MARKET_CLOSE=15:00
TRADING_DAYS=MON,TUE,WED,THU,FRI

# --- Demo Market Engine ---
DEMO_PRICE_VOLATILITY_PCT=1.5
DEMO_TICK_INTERVAL_SECONDS=5

# --- App ---
ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_ORDERS=20/minute

# --- Demo account (development only, do not use in production) ---
